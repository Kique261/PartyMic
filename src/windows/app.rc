#include <windows.h>
#include "partymic_version.h"
1 RT_MANIFEST "app.manifest"

101 ICON "assets/partymic.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PARTYMIC_VERSION_RESOURCE
 PRODUCTVERSION PARTYMIC_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "PartyMic"
   VALUE "FileDescription", "PartyMic"
   VALUE "FileVersion", PARTYMIC_VERSION
   VALUE "InternalName", "PartyMic"
   VALUE "OriginalFilename", "PartyMic.exe"
   VALUE "ProductName", "PartyMic"
   VALUE "ProductVersion", PARTYMIC_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
